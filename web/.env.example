# ── Public (safe in the browser) ────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=hnwav9pa
NEXT_PUBLIC_SANITY_DATASET=production
# Standalone Studio URL (used for click-to-edit overlays in preview)
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Canonical site URL (used for metadata, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only (never exposed to the browser) ──────────────────────────────
# Viewer token — enables draft preview in the Presentation tool.
# Create at https://www.sanity.io/manage → project → API → Tokens (Viewer).
SANITY_API_READ_TOKEN=

# Contact form delivery. Leave empty in development: submissions are logged.
# Resend (https://resend.com) — any provider can be swapped in src/lib/mail.ts.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=spletna-stran@zupnija-pirnice.si

# ── Editor sign-in (admin.<domain>, Better Auth) ────────────────────────────
# Random secret for signing session cookies: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the editor; sign-in links and Google callbacks point here.
BETTER_AUTH_URL=https://admin.zupnija-pirnice.si
# Host that serves the editor (src/proxy.ts). In development admin.localhost
# (any port) is always treated as the admin host.
ADMIN_HOST=admin.zupnija-pirnice.si
# Google sign-in (optional; the button is hidden when unset). OAuth client of
# type "Web application", redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
