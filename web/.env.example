# ── Public (safe in the browser) ────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=hnwav9pa
NEXT_PUBLIC_SANITY_DATASET=production
# Standalone Studio URL (used for click-to-edit overlays in preview)
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Canonical site URL (used for metadata, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only (never exposed to the browser) ──────────────────────────────
# Viewer token — enables draft preview in the Presentation tool.
# Create at https://www.sanity.io/manage → project → API → Tokens (Viewer).
SANITY_API_READ_TOKEN=

# Contact form delivery. Leave empty in development: submissions are logged.
# Resend (https://resend.com) — any provider can be swapped in src/lib/mail.ts.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=spletna-stran@zupnija-pirnice.si
